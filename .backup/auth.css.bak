/* ===== COWRYWISE AUTH (DARK THEME TO MATCH LIVE WEB APP) ===== */
:root {
  --cw-bg: #080c11;
  --cw-card: #131922;
  --cw-card-border: #1e2633;
  --cw-input-bg: #18202b;
  --cw-input-border: #242f3f;
  --cw-input-focus: #0067f5;
  --cw-blue: #0067f5;
  --cw-blue-hover: #0a73ff;
  --cw-text-main: #ffffff;
  --cw-text-muted: #8b99ad;
  --cw-text-placeholder: #5d6d82;
  --cw-text-footer: #465163;
  --cw-font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  min-height: 100%;
  font-family: var(--cw-font);
  background-color: var(--cw-bg);
  color: var(--cw-text-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

/* PAGE WRAPPER */
.auth-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 36px 60px 24px;
  position: relative;
  background-color: var(--cw-bg);
}

/* TOP HEADER / LOGO */
.auth-top-nav {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

.auth-logo-link {
  display: inline-flex;
  align-items: center;
}

.auth-logo-img {
  height: 26px;
  width: auto;
}

/* MAIN CONTENT CONTAINER */
.auth-center-container {
  width: 100%;
  max-width: 1040px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 70px;
  padding: 40px 0;
}

/* LEFT HERO COLUMN (LOGIN) */
.auth-hero-copy {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.auth-hero-title {
  font-size: clamp(38px, 4.2vw, 56px);
  font-weight: 700;
  color: var(--cw-text-main);
  letter-spacing: -0.04em;
  line-height: 1.1;
}

.auth-hero-subtitle {
  font-size: clamp(20px, 2.2vw, 28px);
  font-weight: 500;
  color: var(--cw-text-muted);
  letter-spacing: -0.025em;
  line-height: 1.25;
}

.auth-hero-link {
  margin-top: 18px;
  font-size: 14px;
  color: var(--cw-text-muted);
}

.blue-link {
  color: var(--cw-blue);
  font-weight: 500;
  transition: opacity 0.15s ease;
}

.blue-link:hover {
  text-decoration: underline;
  opacity: 0.9;
}

/* THE AUTH CARD (LOGIN & SIGNUP) */
.auth-card {
  background-color: var(--cw-card);
  border: 1px solid var(--cw-card-border);
  border-radius: 16px;
  padding: 38px 36px 36px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  width: 100%;
  max-width: 480px;
}

/* SIGNUP CARD VARIANT */
.signup-card {
  max-width: 490px;
}

.auth-card-title {
  font-size: clamp(30px, 3.2vw, 42px);
  font-weight: 700;
  color: var(--cw-text-main);
  letter-spacing: -0.035em;
  line-height: 1.15;
  margin-bottom: 6px;
}

.auth-card-sublink {
  font-size: 14px;
  color: var(--cw-text-muted);
  margin-bottom: 28px;
}

/* SOCIAL BUTTONS */
.social-btn-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 24px;
}

.social-btn-single {
  margin-bottom: 24px;
}

.btn-social {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background-color: var(--cw-input-bg);
  border: 1px solid var(--cw-input-border);
  border-radius: 8px;
  color: var(--cw-text-main);
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  padding: 11px 14px;
  cursor: pointer;
  white-space: nowrap;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.btn-social:hover {
  background-color: #202b3a;
  border-color: #2f3e53;
}

.btn-social-pill {
  width: auto;
  display: inline-flex;
  padding: 11px 22px;
}

.social-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* DIVIDER */
.auth-divider {
  display: flex;
  align-items: center;
  text-align: center;
  margin: 20px 0 24px;
  color: var(--cw-text-muted);
  font-size: 13px;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  border-bottom: 1px solid var(--cw-input-border);
}

.auth-divider span {
  padding: 0 14px;
}

/* FORM FIELDS */
.form-group {
  margin-bottom: 16px;
  position: relative;
}

.dark-input {
  width: 100%;
  font-family: inherit;
  font-size: 14px;
  color: var(--cw-text-main);
  background-color: var(--cw-input-bg);
  border: 1px solid var(--cw-input-border);
  border-radius: 8px;
  padding: 14px 16px;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.dark-input::placeholder {
  color: var(--cw-text-placeholder);
}

.dark-input:focus {
  border-color: var(--cw-input-focus);
  box-shadow: 0 0 0 2px rgba(0, 103, 245, 0.25);
}

.dark-input.has-error {
  border-color: #f04438;
}

/* PASSWORD EYE BUTTON */
.pw-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.pw-input-wrap .dark-input {
  padding-right: 44px;
}

.pw-eye-btn {
  position: absolute;
  right: 12px;
  background: none;
  border: 0;
  color: var(--cw-text-muted);
  cursor: pointer;
  padding: 4px;
  display: grid;
  place-items: center;
  transition: color 0.15s ease;
}

.pw-eye-btn:hover {
  color: #fff;
}

.pw-eye-btn svg {
  width: 18px;
  height: 18px;
}

/* FORGOT PASSWORD ROW */
.forgot-row {
  margin: 6px 0 22px;
  text-align: left;
}

.forgot-row a {
  font-size: 13px;
}

/* SUBMIT BUTTON */
.btn-submit {
  width: 100%;
  background-color: var(--cw-blue);
  color: #fff;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  padding: 13px 20px;
  border-radius: 8px;
  border: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background-color 0.2s ease, filter 0.2s ease, transform 0.15s ease;
}

.btn-submit:hover {
  background-color: var(--cw-blue-hover);
  filter: brightness(1.06);
}

.btn-submit:active {
  transform: translateY(1px);
}

.btn-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

/* SPINNER */
.submit-spinner {
  display: none;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: #fff;
  animation: spin 0.6s linear infinite;
}

.btn-submit.loading .submit-spinner {
  display: inline-block;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ALERTS */
.auth-msg {
  display: none;
  font-size: 13px;
  padding: 10px 14px;
  border-radius: 6px;
  margin-bottom: 16px;
}

.auth-msg.error {
  display: block;
  background-color: rgba(240, 68, 56, 0.12);
  border: 1px solid rgba(240, 68, 56, 0.3);
  color: #f97066;
}

.auth-msg.success {
  display: block;
  background-color: rgba(18, 183, 106, 0.12);
  border: 1px solid rgba(18, 183, 106, 0.3);
  color: #32d583;
}

/* SUB-LINKS UNDERNEATH CARD (LOGIN) */
.auth-card-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-sub-links {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--cw-text-muted);
  padding: 0 4px;
}

.auth-sub-links .sub-right a {
  color: var(--cw-text-muted);
  transition: color 0.15s ease;
}

.auth-sub-links .sub-right a:hover {
  color: #fff;
}

.auth-sub-links .sub-right span {
  margin: 0 4px;
  color: #2b3648;
}

/* SIGNUP RIGHT PANEL */
.signup-right-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
}

.signup-side-text {
  margin-bottom: 24px;
}

.side-title {
  font-size: clamp(24px, 2.5vw, 32px);
  font-weight: 700;
  color: var(--cw-text-main);
  letter-spacing: -0.03em;
  margin-bottom: 8px;
}

.side-sub {
  font-size: 15px;
  color: var(--cw-text-muted);
  max-width: 380px;
  line-height: 1.45;
  margin-bottom: 16px;
}

.missed-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 500;
  color: var(--cw-blue);
  transition: transform 0.2s ease;
}

.missed-link:hover {
  text-decoration: underline;
  transform: translateX(3px);
}

.missed-link .sparkle {
  color: #f5a623;
  font-size: 15px;
}

.missed-link .chev-right {
  font-size: 18px;
  line-height: 1;
}

/* SIGNUP MAP ILLUSTRATION */
.signup-map-wrap {
  width: 100%;
  max-width: 440px;
  border-radius: 12px;
  overflow: hidden;
  margin-top: 10px;
}

.signup-map-img {
  width: 100%;
  height: auto;
  display: block;
}

/* FLOATING CHAT WIDGET (SIGNUP & LOGIN) */
.floating-chat-btn {
  position: fixed;
  bottom: 26px;
  right: 28px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: var(--cw-blue);
  color: #fff;
  border: 0;
  cursor: pointer;
  display: grid;
  place-items: center;
  box-shadow: 0 4px 16px rgba(0, 103, 245, 0.45);
  transition: transform 0.2s ease, background-color 0.2s ease;
  z-index: 100;
}

.floating-chat-btn:hover {
  transform: scale(1.08);
  background-color: var(--cw-blue-hover);
}

.floating-chat-btn svg {
  width: 22px;
  height: 22px;
  fill: currentColor;
}

/* FOOTER AT VERY BOTTOM */
.dark-footer {
  width: 100%;
  max-width: 900px;
  margin: 20px auto 0;
  text-align: center;
  padding-top: 14px;
}

.dark-footer p {
  font-size: 11px;
  color: var(--cw-text-footer);
  line-height: 1.6;
}

/* FORGOT PASSWORD MODAL (DARK THEME) */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 500;
  display: none;
  place-items: center;
  padding: 20px;
}

.modal-overlay.open {
  display: grid;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(4, 7, 11, 0.75);
  backdrop-filter: blur(4px);
}

.modal-content-dark {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 440px;
  background-color: var(--cw-card);
  border: 1px solid var(--cw-card-border);
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  color: var(--cw-text-main);
}

.modal-close-dark {
  position: absolute;
  top: 16px;
  right: 16px;
  font-size: 24px;
  line-height: 1;
  background: var(--cw-input-bg);
  border: 1px solid var(--cw-input-border);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: var(--cw-text-muted);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: color 0.15s ease, background-color 0.15s ease;
}

.modal-close-dark:hover {
  color: #fff;
  background-color: #242f3f;
}

.modal-title-dark {
  font-size: 22px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8px;
}

.modal-sub-dark {
  font-size: 13px;
  color: var(--cw-text-muted);
  margin-bottom: 20px;
  line-height: 1.5;
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 960px) {
  .auth-page {
    padding: 24px 20px 20px;
  }

  .auth-center-container {
    grid-template-columns: 1fr;
    gap: 36px;
    padding: 20px 0;
  }

  .auth-card {
    max-width: 100%;
    margin: 0 auto;
  }

  .signup-right-panel {
    align-items: center;
    text-align: center;
  }

  .side-sub {
    max-width: 100%;
  }

  .signup-map-wrap {
    max-width: 360px;
  }

  .floating-chat-btn {
    bottom: 20px;
    right: 20px;
  }
}

@media (max-width: 480px) {
  .social-btn-row {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .auth-card {
    padding: 28px 20px;
  }

  .auth-hero-title {
    font-size: 36px;
  }

  .auth-hero-subtitle {
    font-size: 20px;
  }
}
